<style>
  .armband { width: 300px; height: 286px; padding: 10px; gap: 4px; flex-direction: column; background-color: #101d20; border-color: #826144; border-width: 3px; border-radius: 10px; }
  .title { color: #86dfb4; font-size: 16px; line-height: 1.1; font-weight: 700; }
  .readout { color: #e7fff0; font-size: 16px; line-height: 1.1; }
  .small { color: #b1d1c0; font-size: 12px; line-height: 1.1; }
  .row { flex-direction: row; gap: 6px; }
  .key { width: 132px; height: 40px; padding: 0px; background-color: #234637; border-radius: 8px; justify-content: center; }
  .key-label { font-size: 14px; line-height: 1.1; color: #e7fff0; }
</style>
<div id="armband-root" class="armband">
  <div class="row" style="justify-content: space-between">
    <div class="title">WALL TONES</div><div id="armband-hand-label" class="small">LEFT ARM</div>
  </div>
  <div id="armband-streak" class="readout">Streak: 0 | Best: 0</div>
  <div id="armband-phase" class="small">Ready</div>
  <div id="armband-hint" class="readout">Hint not owned</div>
  <div id="armband-sequence" class="row" style="flex-wrap: wrap; height: 46px"></div>
  <div class="row">
    <Button id="armband-repeat" class="key"><ButtonLabel id="armband-repeat-label" class="key-label">Repeat (0)</ButtonLabel></Button>
    <Button id="armband-modifiers" class="key"><ButtonLabel class="key-label">Modifiers</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="armband-hint-button" class="key"><ButtonLabel class="key-label">Hint upgrade</ButtonLabel></Button>
    <Button id="armband-autoplay" class="key"><ButtonLabel id="armband-autoplay-label" class="key-label">Autoplay</ButtonLabel></Button>
  </div>
  <div id="armband-instructions" class="small">Use your other hand to press</div>
</div>
