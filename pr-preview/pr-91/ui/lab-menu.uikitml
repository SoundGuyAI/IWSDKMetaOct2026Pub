<!--
  Shared Lab menu: lists the capability demos. Rows are wired from
  src/lab-menu/lab-registry.ts. A demo PR connects its row there.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 520px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 18px;
    line-height: 25px;
    margin-bottom: 6px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .content {
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .button {
    justify-content: center;
    height: 64px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .button-label {
    font-size: 20px;
    font-weight: 700;
    transform-translate-y: 1px;
  }
</style>
<Panel id="lab-menu-root" class="panel-root">
  <div id="lab-menu-content" class="content">
    <div id="lab-menu-eyebrow" class="eyebrow">LAB</div>
    <div id="lab-menu-heading" class="heading">Capability demos</div>
    <div id="lab-menu-body" class="body">Capability demos. These show what the app can do today and are not part of the main game yet. They are meant to be integrated into gameplay later.</div>
  </div>
  <Button id="lab-row-nod-button" class="button" style="height: 64px">
    <ButtonIcon><FlaskConical></FlaskConical></ButtonIcon>
    <ButtonLabel id="lab-row-nod-label" class="button-label">Nod Yes/No Lab</ButtonLabel>
  </Button>
  <Button id="lab-row-thumbs-button" class="button" style="height: 64px">
    <ButtonIcon><FlaskConical></FlaskConical></ButtonIcon>
    <ButtonLabel id="lab-row-thumbs-label" class="button-label">Thumbs Yes/No Lab</ButtonLabel>
  </Button>
  <Button id="lab-row-rift-button" class="button" style="height: 64px">
    <ButtonIcon><FlaskConical></FlaskConical></ButtonIcon>
    <ButtonLabel id="lab-row-rift-label" class="button-label">Rift Sealing Lab</ButtonLabel>
  </Button>
  <Button id="lab-menu-back-button" class="button" style="height: 64px; margin-bottom: 24px">
    <ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon>
    <ButtonLabel id="lab-menu-back-label" class="button-label">Back</ButtonLabel>
  </Button>
</Panel>
