<!--
  Hub panel: start Wall Tones or enter XR (which also starts Wall Tones).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 520px;
  }

  .panel-content {
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 18px;
    line-height: 25px;
    margin-bottom: 6px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: center;
    height: 64px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .button-label {
    font-size: 24px;
    font-weight: 700;
    transform-translate-y: 1px;
  }

  .xr-button {
    justify-content: center;
    height: 78px;
    margin-top: 10px;
    margin-left: 20px;
    margin-right: 20px;
    margin-bottom: 28px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .settings-dialog {
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .xr-button-label {
    font-size: 30px;
    font-weight: 700;
    line-height: 34px;
    transform-translate-y: 1px;
  }
</style>
<Panel id="main-menu-root" class="panel-root">
  <div id="main-menu-content" class="panel-content">
    <div id="main-menu-eyebrow" class="eyebrow">WALL TONES</div>
    <div id="main-menu-heading" class="heading">Memory pads</div>
    <div id="main-menu-body" class="body">Start on desktop, or Enter XR to jump straight into Wall Tones in your room.</div>
  </div>
  <Button id="mode-walltones-button" class="button" style="height: 64px">
    <ButtonIcon><LayoutGrid></LayoutGrid></ButtonIcon>
    <ButtonLabel id="mode-walltones-label" class="button-label">Start Wall Tones</ButtonLabel>
  </Button>
  <Button id="xr-button" class="xr-button" style="height: 78px">
    <ButtonIcon><RectangleGoggles></RectangleGoggles></ButtonIcon>
    <ButtonLabel id="xr-button-label" class="xr-button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="settings-button" class="button" style="height: 64px; margin-bottom: 28px">
    <ButtonIcon><Settings></Settings></ButtonIcon>
    <ButtonLabel id="settings-button-label" class="button-label">Settings</ButtonLabel>
  </Button>
  <div id="settings-dialog" class="settings-dialog" style="display: none">
    <div id="settings-eyebrow" class="eyebrow">SETTINGS</div>
    <div id="settings-heading" class="heading">Voice</div>
    <div id="settings-body" class="body">Pick the host voice. A preview plays right away.</div>
    <Button id="voice-male-button" class="button" style="height: 64px">
      <ButtonIcon><User></User></ButtonIcon>
      <ButtonLabel id="voice-male-label" class="button-label">Male voice</ButtonLabel>
    </Button>
    <Button id="voice-female-button" class="button" style="height: 64px">
      <ButtonIcon><User></User></ButtonIcon>
      <ButtonLabel id="voice-female-label" class="button-label">Female voice</ButtonLabel>
    </Button>
    <Button id="settings-back-button" class="button" style="height: 64px; margin-bottom: 4px">
      <ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon>
      <ButtonLabel class="button-label">Back</ButtonLabel>
    </Button>
  </div>
  <Button id="exit-button" class="button" style="display: none; margin-bottom: 28px">
    <ButtonIcon><LogIn></LogIn></ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
