<!--
  Hub panel: pick which experience to open. Horizon kit + Lucide icons.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 520px;
  }

  .panel-content {
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 18px;
    line-height: 25px;
    margin-bottom: 6px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
  }

  .button-last {
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }

  .hint {
    color: #4d5158;
    font-size: 14px;
    line-height: 19px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 8px;
  }

  .hint:dark {
    color: #b8c4ce;
  }

  .xr-button {
    justify-content: center;
    height: 78px;
    margin-top: 22px;
    margin-left: 20px;
    margin-right: 20px;
    margin-bottom: 28px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .xr-button-label {
    font-size: 30px;
    font-weight: 700;
    line-height: 34px;
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">IWSDK EXPERIENCES</div>
    <div class="heading">Choose a mode</div>
    <div class="body">Point and click the buttons here on desktop, or gaze and pinch in XR. Enter XR when you are ready.</div>
  </div>
  <Button id="mode-demo-button" class="button">
    <ButtonIcon><Bot></Bot></ButtonIcon>
    <ButtonLabel class="button-label">Starter demo</ButtonLabel>
  </Button>
  <Button id="mode-meditation-button" class="button">
    <ButtonIcon><Activity></Activity></ButtonIcon>
    <ButtonLabel class="button-label">Breath &amp; gaze rest</ButtonLabel>
  </Button>
  <Button id="mode-walltones-button" class="button button-last">
    <ButtonIcon><LayoutGrid></LayoutGrid></ButtonIcon>
    <ButtonLabel class="button-label">Wall Tones (planned)</ButtonLabel>
  </Button>
  <div class="hint">Wall Tones is a room-scale memory puzzle on Quest. Design coming in a future session.</div>
  <Button id="xr-button" class="xr-button" style="height: 78px">
    <ButtonIcon><RectangleGoggles></RectangleGoggles></ButtonIcon>
    <ButtonLabel class="xr-button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button button-last" style="display: none">
    <ButtonIcon><LogIn></LogIn></ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
