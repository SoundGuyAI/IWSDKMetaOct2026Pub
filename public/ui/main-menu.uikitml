<!--
  Hub panel: start Wall Tones or enter XR (which also starts Wall Tones).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 520px;
  }

  .panel-content {
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 18px;
    line-height: 25px;
    margin-bottom: 6px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .button {
    justify-content: center;
    height: 64px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .button-label {
    font-size: 24px;
    font-weight: 700;
    transform-translate-y: 1px;
  }

  .xr-button {
    justify-content: center;
    height: 78px;
    margin-top: 10px;
    margin-left: 20px;
    margin-right: 20px;
    margin-bottom: 28px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .xr-button-label {
    font-size: 30px;
    font-weight: 700;
    line-height: 34px;
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">WALL TONES</div>
    <div class="heading">Memory pads</div>
    <div class="body">Start on desktop, or Enter XR to jump straight into Wall Tones in your room.</div>
  </div>
  <Button id="mode-walltones-button" class="button" style="height: 64px">
    <ButtonIcon><LayoutGrid></LayoutGrid></ButtonIcon>
    <ButtonLabel class="button-label">Start Wall Tones</ButtonLabel>
  </Button>
  <Button id="xr-button" class="xr-button" style="height: 78px">
    <ButtonIcon><RectangleGoggles></RectangleGoggles></ButtonIcon>
    <ButtonLabel class="xr-button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none; margin-bottom: 28px">
    <ButtonIcon><LogIn></LogIn></ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
